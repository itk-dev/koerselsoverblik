{# The grid lines with the values of the vertical axis. The sizes come from App\Chart\Scale.
   A share or a percent shows the exact grid value, for example 12,5 %, not a rounded value. #}
{% set left = constant('App\\Chart\\Scale::LEFT') %}
{% set right = geometry.right %}
{% for line in geometry.gridLines %}
    <line class="ch-grid" x1="{{ left }}" x2="{{ right }}" y1="{{ line.y }}" y2="{{ line.y }}"/>
    <text class="ch-ytick" x="{{ constant('App\\Chart\\Scale::TICK_X') }}" y="{{ line.y + constant('App\\Chart\\Scale::TICK_Y_OFFSET') }}">{{ unit in ['share', 'percent'] ? line.value|axis_percent : line.value|number_format }}</text>
{% endfor %}
