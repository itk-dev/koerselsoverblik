{# The grid lines with the values of the vertical axis. The sizes come from App\Chart\Scale. #}
{% set left = constant('App\\Chart\\Scale::LEFT') %}
{% set right = constant('App\\Chart\\Scale::RIGHT') %}
{% for line in geometry.gridLines %}
    <line class="ch-grid" x1="{{ left }}" x2="{{ right }}" y1="{{ line.y }}" y2="{{ line.y }}"/>
    <text class="ch-ytick" x="{{ constant('App\\Chart\\Scale::TICK_X') }}" y="{{ line.y + constant('App\\Chart\\Scale::TICK_Y_OFFSET') }}">{{ line.value|number_format }}{{ unit == 'percent' ? ' %' }}</text>
{% endfor %}
