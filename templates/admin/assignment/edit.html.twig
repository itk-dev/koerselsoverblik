{% extends 'base.html.twig' %}

{% set sub_agreement = data.subAgreement %}
{% set heading = (data.assignment ? 'assignment.edit_title' : 'assignment.new_title')|trans({reference: sub_agreement.reference}) %}

{% block title %}{{ heading }} – {{ 'app.name'|trans }}{% endblock %}

{% block body %}
    <h1>{{ heading }}</h1>

    {{ form_start(form, {attr: {class: 'admin-form'}}) }}
        {{ form_widget(form) }}
        <div class="admin-form__buttons">
            <button class="itkaarhus-btn itkaarhus-btn--primary" type="submit">{{ 'common.save'|trans }}</button>
            <a class="itkaarhus-btn itkaarhus-btn--secondary" href="{{ path('admin_sub_agreement_show', {id: sub_agreement.id}) }}">{{ 'common.cancel'|trans }}</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
