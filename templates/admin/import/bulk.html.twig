{% extends 'base.html.twig' %}

{% block title %}{{ 'upload.bulk.title'|trans }} – {{ 'app.name'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'upload.bulk.title'|trans }}</h1>
    {{ include('admin/import/_tabs.html.twig', {current: 'bulk'}) }}

    <p>{{ 'upload.bulk.intro'|trans }}</p>

    <div class="bulk-upload"
         data-controller="bulk-upload"
         data-action="dropzone:change->bulk-upload#add"
         data-bulk-upload-check-url-value="{{ path('admin_import_bulk_check') }}"
         data-bulk-upload-csrf-token-value="{{ csrf_token('bulk-import') }}">
        {{ form_start(form, {attr: {class: 'admin-form'}}) }}
            {{ form_row(form.files) }}
        {{ form_end(form) }}

        <div class="itkaarhus-callout itkaarhus-callout--info">
            <ul>
                <li data-test="bulk-max-days">{{ 'upload.bulk.caution.max_days'|trans({limit: maxDays}) }}</li>
                <li>{{ 'upload.bulk.caution.range'|trans }}</li>
                <li>{{ 'upload.bulk.caution.overlap'|trans }}</li>
                <li>{{ 'upload.caution.whole_days'|trans }}</li>
                <li>{{ 'upload.bulk.caution.no_undo'|trans }}</li>
            </ul>
        </div>

        {# The bar stays at the top of the window, so that the status is visible in a long list. #}
        <div class="bulk-upload__bar">
            <ul class="bulk-upload__counts" aria-live="polite">
                {% for state, tone in {waiting: 'neutral', checked: 'info', imported: 'success', skipped: 'warning', failed: 'danger'} %}
                    <li class="itkaarhus-tag itkaarhus-tag--{{ tone }}">
                        {{ ('upload.bulk.state.' ~ state)|trans }}
                        <span data-bulk-upload-target="count" data-state="{{ state }}" data-test="bulk-count-{{ state }}">0</span>
                    </li>
                {% endfor %}
            </ul>
            <button class="itkaarhus-btn itkaarhus-btn--primary" type="button" disabled
                    data-bulk-upload-target="importButton" data-action="bulk-upload#import">
                {{ 'upload.bulk.import'|trans }}
            </button>
        </div>

        <ol class="bulk-upload__list" data-bulk-upload-target="list" data-test="bulk-list"></ol>

        {# The controller opens the dialog when the last import is done. "OK" closes it with no script. #}
        <dialog class="about bulk-upload__done" aria-labelledby="bulk-done-title" data-bulk-upload-target="doneDialog" data-test="bulk-done">
            <form method="dialog">
                <header class="about__head">
                    <h2 id="bulk-done-title">{{ 'upload.bulk.done'|trans }}</h2>
                </header>
                <div class="about__body">
                    <dl class="upload-summary">
                        {% for state in ['imported', 'skipped', 'failed'] %}
                            <dt>{{ ('upload.bulk.state.' ~ state)|trans }}</dt>
                            <dd data-bulk-upload-target="count" data-state="{{ state }}">0</dd>
                        {% endfor %}
                    </dl>
                    <div class="admin-form__buttons">
                        <button class="itkaarhus-btn itkaarhus-btn--primary" value="ok" autofocus>{{ 'upload.bulk.ok'|trans }}</button>
                    </div>
                </div>
            </form>
        </dialog>

        {# The controller copies these rows. The server sends the other rows. #}
        <template data-bulk-upload-target="waitingRow">
            <li class="bulk-upload__file" data-test="bulk-file" data-state="waiting">
                <span class="bulk-upload__name" data-test="bulk-name"></span>
                {{ include('admin/import/_bulk_state.html.twig', {state: 'waiting'}) }}
            </li>
        </template>
        <template data-bulk-upload-target="failedRow">
            <li class="bulk-upload__file" data-test="bulk-file" data-state="failed">
                <span class="bulk-upload__name" data-test="bulk-name"></span>
                {{ include('admin/import/_bulk_state.html.twig', {state: 'failed'}) }}
                <span class="bulk-upload__detail bulk-upload__message" data-test="bulk-error">{{ 'upload.bulk.request_failed'|trans }}</span>
            </li>
        </template>
    </div>
{% endblock %}
