{# The copy of a row, column by column. The person id shows as "(skjult)". A value is text from the extract, so it is not translated. #}
<h2>{{ 'driving_data.copy'|trans }}</h2>
{% if copy.mappingMissing %}
    <div class="itkaarhus-callout itkaarhus-callout--info" data-test="mapping-missing">{{ 'driving_data.mapping_missing'|trans({name: mappingName}) }}</div>
{% else %}
    <div class="table-wrap">
        <table class="itkaarhus-table data-table source-row" data-test="source-row">
            <thead>
                <tr>
                    <th scope="col">{{ 'driving_data.column'|trans }}</th>
                    <th scope="col">{{ 'driving_data.value'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for column in copy.columns %}
                    <tr{% if column.cause %} class="source-row__cause" data-test="cause"{% endif %}>
                        <th scope="row" data-test="source-column">{{ column.column }}</th>
                        <td{% if column.hidden %} data-test="hidden-value"{% endif %}>
                            {{ column.message ? column.message|trans : column.value }}
                            {% if column.cause %}<span class="sr-only">{{ 'driving_data.cause'|trans }}</span>{% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
