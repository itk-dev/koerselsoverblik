{% extends 'base.html.twig' %}

{% block title %}{{ sub_agreement.reference }} – {{ 'app.name'|trans }}{% endblock %}

{% block body %}
    <p><a class="itkaarhus-link" href="{{ path('admin_sub_agreement_index') }}">{{ 'sub_agreement.back'|trans }}</a></p>
    <h1>{{ 'sub_agreement.show_title'|trans({reference: sub_agreement.reference}) }}</h1>
    {% if sub_agreement.ignored %}
        <p data-test="ignored"><span class="itkaarhus-tag itkaarhus-tag--neutral">{{ 'sub_agreement.ignored_tag'|trans }}</span> {{ 'sub_agreement.ignored_help'|trans }}</p>
    {% endif %}

    <h2>{{ 'sub_agreement.supplier'|trans }}</h2>
    <p data-test="supplier">{{ sub_agreement.supplier ? sub_agreement.supplier.name : 'sub_agreement.no_supplier'|trans }}</p>
    <p><a class="itkaarhus-btn itkaarhus-btn--primary" href="{{ path('admin_sub_agreement_edit', {id: sub_agreement.id}) }}" data-test="sub-agreement-edit">{{ 'sub_agreement.edit'|trans }}</a></p>

    <h2>{{ 'sub_agreement.routes'|trans }}</h2>
    {% if sub_agreement.routes is empty %}
        <p data-test="route-none">{{ 'sub_agreement.no_routes'|trans }}</p>
    {% else %}
        <ul data-test="route-list">
            {% for route in sub_agreement.routes %}
                <li>{{ route.sourceKey }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
