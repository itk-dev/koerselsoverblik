{% set menu = main_menu() %}
{# The brand goes to the first page that the user can see. Without such a page, it is not a link. #}
{% set home = menu|first %}
{% set brand_tag = home ? 'a' : 'span' %}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{{ 'app.name'|trans }}{% endblock %}</title>
        <link rel="icon" href="{{ asset('itkaarhus-ds/logos/aak-emblem.svg') }}">
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('itkaarhus-ds/tokens.css') }}">
            <link rel="stylesheet" href="{{ asset('itkaarhus-ds/components.css') }}">
        {% endblock %}
        {% block javascripts %}
            {{ importmap('app', {nonce: csp_nonce('script')}) }}
        {% endblock %}
    </head>
    <body>
        <a class="skip" href="#content">{{ 'layout.skip_to_content'|trans }}</a>

        <div class="shell" data-shell>
            <aside class="rail" id="rail" data-rail>
                <{{ brand_tag }} class="brand"{% if home %} href="{{ home.url }}"{% endif %} data-test="brand">
                    <img class="brand__mark" src="{{ asset('itkaarhus-ds/logos/aak-emblem.svg') }}" alt="">
                    <span class="brand__text">
                        <b>{{ 'app.name'|trans }}</b>
                        <small>{{ 'app.owner'|trans }}</small>
                    </span>
                </{{ brand_tag }}>

                <nav class="nav" aria-label="{{ 'menu.label'|trans }}" data-nav>
                    {{ include('_menu.html.twig', {items: menu}) }}
                </nav>

                <div class="rail__foot">
                    <button class="about-link" type="button" data-about-open>{{ 'about.title'|trans }}</button>
                </div>
            </aside>

            <div class="main">
                <header class="topbar">
                    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="rail" data-nav-toggle>
                        {{ ux_icon('lucide:menu', {height: 20, width: 20}) }}
                        <span class="sr-only">{{ 'layout.show_menu'|trans }}</span>
                    </button>
                    <div class="topbar__controls">
                        {% block topbar_controls %}{% endblock %}
                    </div>
                    {% if app.user %}
                        <div class="user-menu" data-test="user-menu">
                            {{ ux_icon('lucide:user') }}
                            <span class="user-menu__name">{{ app.user.userIdentifier }}</span>
                        </div>
                    {% endif %}
                </header>

                <main class="content" id="content" tabindex="-1">
                    {% for type, messages in app.flashes(['success', 'error']) %}
                        {% for message in messages %}
                            <div class="itkaarhus-callout itkaarhus-callout--{{ type == 'error' ? 'warn' : 'success' }} flash" role="status" data-test="flash-{{ type }}">{{ message|trans }}</div>
                        {% endfor %}
                    {% endfor %}
                    {% block body %}{% endblock %}
                </main>
            </div>
        </div>

        <dialog class="about" aria-labelledby="about-title" data-about-dialog data-test="about-dialog">
            <form method="dialog" class="about__form">
                <header class="about__head">
                    <h2 id="about-title">{{ 'about.title'|trans }}</h2>
                    <button class="about__close" value="close" aria-label="{{ 'about.close'|trans }}">
                        {{ ux_icon('lucide:x') }}
                    </button>
                </header>
                <div class="about__body">
                    <p>{{ 'about.placeholder'|trans }}</p>
                </div>
            </form>
        </dialog>
    </body>
</html>
