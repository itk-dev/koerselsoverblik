{#
    Lucide icons, as in the prototype. The design system sprite holds the common icons.
    The other icons are inline paths, so that the sprite stays the same for all projects.
#}
{% macro icon(name, size = 18, class = 'icon') %}
    {%- set sprite = ['check', 'chevron-down', 'chevron-left', 'chevron-right', 'chevron-up', 'info', 'menu', 'search', 'user', 'users', 'x'] -%}
    {%- set paths = {
        calendar: '<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>',
        car: '<path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/>',
        dashboard: '<rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/>',
    } -%}
    {%- if name in sprite -%}
        <svg class="{{ class }}" width="{{ size }}" height="{{ size }}" aria-hidden="true" focusable="false"><use href="{{ asset('itkaarhus-ds/lucide-sprite.svg') }}#lucide-{{ name }}"/></svg>
    {%- elseif paths[name] is defined -%}
        <svg class="{{ class }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">{{ paths[name]|raw }}</svg>
    {%- endif -%}
{% endmacro %}
