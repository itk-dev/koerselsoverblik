parameters:
    level: max
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    excludePaths:
        - config/reference.php
    # Composer does not autoload the migrations. A test loads one of them.
    scanDirectories:
        - migrations/
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
