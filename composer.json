{
    "name": "itk-dev/koerselsoverblik",
    "description": "Key figures for citizen transport",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-xmlreader": "*",
        "ext-zip": "*",
        "doctrine/collections": "^3.1",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3.4",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7.6",
        "doctrine/persistence": "^4.2.1",
        "itk-dev/itkaarhus-design-system": "^0.6.0",
        "itk-dev/openid-connect": "^5.1",
        "itk-dev/openid-connect-bundle": "^6.1",
        "nelmio/security-bundle": "^3.9",
        "openspout/openspout": "^5.13",
        "psr/clock": "^1.0",
        "psr/log": "^3.0.2",
        "symfony/asset": "~8.1.0",
        "symfony/asset-mapper": "~8.1.11",
        "symfony/clock": "~8.1.0",
        "symfony/config": "~8.1.11",
        "symfony/console": "~8.1.11",
        "symfony/dependency-injection": "~8.1.11",
        "symfony/doctrine-bridge": "~8.1.10",
        "symfony/dotenv": "~8.1.0",
        "symfony/event-dispatcher": "~8.1.5",
        "symfony/flex": "^2.12",
        "symfony/form": "~8.1.11",
        "symfony/framework-bundle": "~8.1.11",
        "symfony/http-foundation": "~8.1.11",
        "symfony/http-kernel": "~8.1.11",
        "symfony/monolog-bundle": "^4.1",
        "symfony/options-resolver": "~8.1.10",
        "symfony/routing": "~8.1.11",
        "symfony/runtime": "~8.1.11",
        "symfony/security-bundle": "~8.1.11",
        "symfony/security-core": "~8.1.11",
        "symfony/security-csrf": "~8.1.0",
        "symfony/security-http": "~8.1.11",
        "symfony/translation": "~8.1.11",
        "symfony/twig-bundle": "~8.1.0",
        "symfony/ux-icons": "^3.7",
        "symfony/ux-twig-component": "^3.6",
        "symfony/validator": "~8.1.11",
        "symfony/yaml": "~8.1.11",
        "twig/twig": "^3.30"
    },
    "require-dev": {
        "ext-dom": "*",
        "ext-simplexml": "*",
        "dama/doctrine-test-bundle": "^8.7",
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "ergebnis/composer-normalize": "^2.56",
        "friendsofphp/php-cs-fixer": "^3.95.28",
        "infection/infection": "^0.35.9",
        "monolog/monolog": "^3.12.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3.5",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-doctrine": "^2.1",
        "phpstan/phpstan-symfony": "^2.1.1",
        "phpunit/phpunit": "^13.4.6",
        "rector/rector": "^2.8",
        "rregeer/phpunit-coverage-check": "^0.3.1",
        "symfony/browser-kit": "~8.1.11",
        "symfony/css-selector": "~8.1.10",
        "symfony/dom-crawler": "~8.1.10",
        "vincentlanglet/twig-cs-fixer": "^4.1",
        "zenstruck/foundry": "^2.15"
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*",
        "symfony/polyfill-php85": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "repositories": [
        {
            "name": "itkaarhus-ds",
            "type": "vcs",
            "url": "https://github.com/itk-dev/itkaarhus-design-system",
            "no-api": true
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "docker": false,
            "require": "8.1.*"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        }
    }
}
