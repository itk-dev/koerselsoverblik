---
title: Authentication modes
---
flowchart TD
    request["Request"] --> public{"Public path?<br/>/login, assets"}
    public -- yes --> serve["Serve"]
    public -- no --> mode{"APP_AUTH_MODE"}

    mode -- none --> prodcheck{"APP_ENV=prod and<br/>APP_ALLOW_NO_LOGIN_IN_PROD≠1?"}
    prodcheck -- yes --> refuse["Refuse to start"]
    prodcheck -- no --> nologin["NoLoginAuthenticator<br/>local user with APP_NO_LOGIN_ROLES"]

    mode -- password --> session{"Logged in?"}
    session -- no --> login["Redirect to /login<br/>form with CSRF and rate limiting"]
    session -- yes --> user["User from the database"]

    mode -- oidc --> oidc["OIDC authenticator<br/>(later milestone)"]

    nologin --> guard{"#[IsGranted] role?"}
    user --> guard
    oidc --> guard
    guard -- granted --> controller["Controller"]
    guard -- denied --> forbidden["403"]
