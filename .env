COMPOSE_PROJECT_NAME=koerselsoverblik
COMPOSE_DOMAIN=koerselsoverblik.local.itkdev.dk
ITKDEV_TEMPLATE=symfony-8

# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
DATABASE_URL="mysql://db:db@mariadb:3306/db?serverVersion=10.11.19-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> itk-dev/openid-connect-bundle ###
# The defaults point to the local mock service (the idp service in docker-compose.override.yml).
# On a server, set the values from the real identity provider in .env.local.
OIDC_METADATA_URL=http://idp.koerselsoverblik.local.itkdev.dk/.well-known/openid-configuration
OIDC_CLIENT_ID=client-id
OIDC_CLIENT_SECRET=client-secret
# The date the client secret expires, for example 2027-01-31. Set it with the real secret.
# Empty means not monitored: the bundle logs an error at each login.
OIDC_CLIENT_SECRET_EXPIRES_AT=
OIDC_REDIRECT_URI=https://koerselsoverblik.local.itkdev.dk/openid-connect/generic
OIDC_ROLE_CLAIM=roles
# Only the local mock service runs on HTTP. .env.dev sets this to true.
OIDC_ALLOW_HTTP=false
###< itk-dev/openid-connect-bundle ###

# The import mapping for uploads of driving data. See "Import mappings" in the README.
APP_DRIVING_DATA_MAPPING=default
# The maximum number of days in one upload of driving data. See "Configuration" in the README.
APP_DRIVING_DATA_MAX_DAYS=7
# The limits for one extract of driving data. See "Configuration" in the README.
APP_DRIVING_DATA_MAX_FILE_SIZE=20971520
APP_DRIVING_DATA_MAX_UNCOMPRESSED_SIZE=104857600
APP_DRIVING_DATA_MAX_ROWS=50000
APP_DRIVING_DATA_MAX_COLUMNS=200
# The first date of the driving data, as YYYY-MM-DD, or empty for no limit. A period before this
# date has no data, and a comparison that starts before it is a partial period. See
# "Configuration" in the README.
APP_DATA_START_DATE=
# The punctuality of the development dataset (`task fixtures:extracts`), not of real data: the
# share in percent of the runs with an on-time last drop-off in the first month, and the change
# in percentage points for each month after it (negative for worse). See "Development" in the README.
APP_FIXTURES_PUNCTUALITY_START=65
APP_FIXTURES_PUNCTUALITY_TREND=2.5
# The punctuality rules. See "Configuration" in the README.
APP_PUNCTUALITY_TOLERANCE_MINUTES=5
APP_PUNCTUALITY_TARGET=90
